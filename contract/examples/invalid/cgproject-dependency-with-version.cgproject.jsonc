// Negative test: a dependency has a version (not part of version 1)
{
  "apiVersion": "portunix.ai/v1",
  "kind": "Project",
  "metadata": {
    "id": "demo",
    "name": "Demo",
    "version": "0.1.0"
  },
  "spec": {
    "type": "software",
    "requires": [
      {
        "plugin": "crawler"
      }
    ],
    "artifacts": [
      {
        "id": "src",
        "type": "source",
        "path": "sources/a.md"
      },
      {
        "id": "doc",
        "type": "document",
        "path": "out/a.pdf",
        "derivedFrom": [
          "src"
        ]
      }
    ],
    "dependencies": [
      {
        "project": "api",
        "version": "1.0.0"
      }
    ],
    "goals": {
      "build": {
        "run": "make build",
        "inputs": [
          "src"
        ],
        "outputs": [
          "doc"
        ]
      }
    }
  }
}
