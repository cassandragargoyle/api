{# Cover of the VIM book: one invoice page under a stack of six layer sheets, each sheet shows its key and what it adds #}
<svg class="cover-art" viewBox="0 0 520 300" xmlns="http://www.w3.org/2000/svg">
  {# The source page with text lines and a QR code #}
  <rect x="14" y="40" width="150" height="212" rx="3" fill="#ffffff" stroke="#c4ccd6" stroke-width="1.6"/>
  <rect x="30" y="58" width="78" height="9" rx="2" fill="#1d2a3a"/>
  {% for row in range(5) %}
    <rect x="30" y="{{ 84 + row * 14 }}" width="{{ [100, 84, 112, 70, 96][row] }}" height="5" rx="2" fill="#aeb8c4"/>
  {% endfor %}
  <rect x="30" y="160" width="118" height="44" fill="none" stroke="#aeb8c4" stroke-width="1.2"/>
  <line x1="30" y1="175" x2="148" y2="175" stroke="#aeb8c4" stroke-width="1"/>
  <line x1="30" y1="190" x2="148" y2="190" stroke="#aeb8c4" stroke-width="1"/>
  <line x1="88" y1="160" x2="88" y2="204" stroke="#aeb8c4" stroke-width="1"/>
  <rect x="30" y="214" width="26" height="26" fill="#1d2a3a"/>
  <rect x="35" y="219" width="7" height="7" fill="#ffffff"/>
  <rect x="44" y="228" width="7" height="7" fill="#ffffff"/>
  {# Rays from the page to the layer stack #}
  <g stroke="#c4ccd6" stroke-width="1.2" stroke-dasharray="3 4" fill="none">
    <path d="M164 70 L206 34"/>
    <path d="M164 230 L190 272"/>
  </g>
  {# Six sheets, bottom (physical) to top (prescriptive) #}
  {% set sheets = [
    ("prescriptive", "#7c3aed", labels.cover_prescriptive),
    ("extraction", "#1f6fb2", labels.cover_extraction),
    ("toc", "#0f8b8d", labels.cover_toc),
    ("semantic", "#2f9e6a", labels.cover_semantic),
    ("structural", "#d97706", labels.cover_structural),
    ("physical", "#e5484d", labels.cover_physical),
  ] %}
  {% for key, color, note in sheets %}
    {% set y = 26 + loop.index0 * 42 %}
    <path d="M{{ 206 }} {{ y + 8 }} L{{ 514 }} {{ y + 8 }} L{{ 496 }} {{ y + 36 }} L{{ 188 }} {{ y + 36 }} Z"
          fill="{{ color }}" fill-opacity="0.12" stroke="{{ color }}" stroke-width="2"/>
    <text x="210" y="{{ y + 27 }}" class="cover-art-value" fill="{{ color }}">{{ key }}</text>
    <text x="490" y="{{ y + 27 }}" class="cover-art-label" fill="#5f6b7a" text-anchor="end">{{ note }}</text>
  {% endfor %}
</svg>
